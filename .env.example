# =============================================================================
# stock_data_downloader 環境變數設定範本 (.env.example)
# =============================================================================

# Google Drive 備份設定 (可選)
GDRIVE_FOLDER_ID=your_gdrive_folder_id
GDRIVE_UPLOAD_URL=your_gdrive_upload_url
GDRIVE_SERVICE_ACCOUNT_KEY=

# Telegram 機器人即時推播通知 (可選)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email 郵件報告通知 (可選)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
RECEIVER_EMAIL=

# =============================================================================
# 台股開盤營業日檢查設定 (Trading Day Calendar)
# =============================================================================
# 是否在抓取前自動檢查今天是否為開盤日 (預設 true，非開盤日則自動跳過抓取)
CHECK_TRADING_DAY=true

# 是否強制抓取 (若設為 true 則無論平日、週末或國定假日均強制發起抓取)
FORCE_CRAWL=false
